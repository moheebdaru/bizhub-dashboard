# Copy this file to .env.local and fill in your values
# DO NOT commit .env.local to GitHub

# --- Sales feed (Google Sheets) ---
GOOGLE_API_KEY=your_google_api_key_here
SHEET_ID=your_google_sheet_id_here

# --- Finance feed (Google Sheets) ---
# Reads live figures directly from the "P&L Statement" tab of the
# daru_finance_master Google Sheet. That sheet must have general access set to
# "Anyone with the link: Viewer" since this uses a simple API key, not OAuth.
FINANCE_SHEET_ID=1VrKNrMNOrtz57KGdyMYazbcS3ha1Cskz6vgRjPU3PlU

# --- Shopify feed (Admin API) ---
# Create a custom app in Shopify (Settings > Apps and sales channels > Develop apps)
# with read_orders and read_products scopes, then use its Admin API access token.
SHOPIFY_STORE_DOMAIN=hjy760-ti.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=your_shopify_admin_api_access_token_here
