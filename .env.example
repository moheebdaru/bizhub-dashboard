# Copy this file to .env.local and fill in your values
# DO NOT commit .env.local to GitHub

# --- Sales feed (Google Sheets) ---
GOOGLE_API_KEY=your_google_api_key_here
SHEET_ID=your_google_sheet_id_here

# --- Finance feed (Google Sheets) ---
# Reads a tab named "Finance Dashboard Input" with two columns: Metric | Value
# If your finance data lives in the same spreadsheet as your sales data, you
# can omit this and it will fall back to SHEET_ID above.
FINANCE_SHEET_ID=your_finance_google_sheet_id_here

# --- Shopify feed (Admin API) ---
# Create a custom app in Shopify (Settings > Apps and sales channels > Develop apps)
# with read_orders and read_products scopes, then use its Admin API access token.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=your_shopify_admin_api_access_token_here
